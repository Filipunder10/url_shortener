@using UrlShortener.Data
@using UrlShortener.Models.ViewModels

@page "/secret/{shortCode}/{secretCode}"
@attribute [StreamRendering]

@inject UrlShortenerContext dbContext
@inject NavigationManager Navigation


<p>Here you can see the top 10 all-time user IPs by the number of unique visits per day 
    (times they have opened the shortened URL)</p>

@if (visits == null)
{
    <p>
        <em>Loading...</em>
    </p>
}
else
{
    <table class="table">
        <thead>
        <tr>
            <th>Client Ip</th>
            <th>Number of visits</th>
        </tr>
        </thead>
        <tbody>
        @foreach (var visit in visits)
        {
            <tr>
                <td>@visit.ClientIp</td>
                <td>@visit.VisitCount</td>
            </tr>
        }
        </tbody>
    </table>
}

@code {
    [Parameter] public string shortCode { get; set; }
    [Parameter] public string secretCode { get; set; }
    private VisitSummary[]? visits;

    protected override async Task OnInitializedAsync()
    {
        if (!dbContext.ShortenedUrls.Any(x => x.ShortCode == shortCode && x.SecretCode == secretCode))
        {
            Navigation.NavigateTo("error404", true);
            return;
        }
        
        visits = dbContext.Visits
            .Where(x => x.ShortCode == shortCode)
            .GroupBy(x => new { x.ClientIp, Date = x.VisitedAt.Date })
            .Select(g => new { g.Key.ClientIp, g.Key.Date })
            .GroupBy(x => x.ClientIp)
            .Select(g => new VisitSummary
            {
                ClientIp = g.Key,
                VisitCount = g.Count()
            })
            .OrderByDescending(x => x.VisitCount)
            .Take(10)
            .ToArray();
    }
}