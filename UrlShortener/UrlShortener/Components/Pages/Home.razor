@using UrlShortener.Data
@using UrlShortener.Models

@page "/"
@rendermode InteractiveServer

@inject UrlShortenerContext dbContext
@inject NavigationManager navigationManager
@inject IJSRuntime JS


<PageTitle>Home</PageTitle>

<p>Welcome to the UrlShortener, please enter a URL to get a short one. You will also get a secret one, which you can 
    visit to track visits.</p>

<p>Enter a URL.</p>


<textarea @bind="url" style="width: 80rem; min-height: 1rem; max-height: 10rem; resize: none;"
          oninput="this.style.height='auto';this.style.height=this.scrollHeight + 'px';"></textarea>


<button class="btn btn-primary" @onclick="GenerateUrl" style="margin-bottom: 2rem">Shorten Url</button>


<p>
    @if (!string.IsNullOrEmpty(shortUrl))
    {
        <p>Short url:</p>
        <a href="@shortUrl" target="_blank">@shortUrl</a>
        <button class="btn btn-outline-secondary" @onclick="CopyShortToClipboard" style="margin-left: 1rem;">
            <i class="bi bi-clipboard"></i>
        </button>
    }
</p>

<p>
    
    @if (!string.IsNullOrEmpty(secretUrl))
    {   
        <p>Secret url:</p>
        <a href="@secretUrl" target="_blank">@secretUrl</a>
        <button class="btn btn-outline-secondary" @onclick="CopySecretToClipboard" style="margin-left: 1rem;">
            <i class="bi bi-clipboard"></i>
        </button>
    }
</p>

<p style="color: red;">@statusMessage</p>

<script>
    window.copyShortToClipboard = function (text) {
        navigator.clipboard.writeText(text)
            .then(() => console.log("Copied to clipboard"))
            .catch(err => console.error("Failed to copy!", err));
    };
    window.copySecretToClipboard = function (text) {
        navigator.clipboard.writeText(text)
            .then(() => console.log("Copied to clipboard"))
            .catch(err => console.error("Failed to copy!", err));
    };
</script>

@code {
    private string url = "";
    private string shortUrl = "";
    private string secretUrl = "";
    private string statusMessage = "";
    private static Random random = new Random();
    
    private void GenerateUrl()
    {
        url = url.Trim();
        if (!IsValidUrl(url))
        {
            shortUrl = "";
            secretUrl = "";
            return;
        } else
        {
            statusMessage = "";
        }
        
        var shortCode = GenerateShortCode(12);
        var secretCode = GenerateShortCode(24);
        
        var record = new ShortenedUrl
        {
            OriginalUrl = url,
            ShortCode = shortCode,
            SecretCode = secretCode,
            CreatedAt = DateTime.UtcNow
        };

        dbContext.ShortenedUrls.Add(record);
        dbContext.SaveChanges();

        shortUrl = $"{navigationManager.BaseUri}redirect/{shortCode}";
        secretUrl = $"{navigationManager.BaseUri}secret/{shortCode}/{secretCode}";
    }

    private bool IsValidUrl(string url)
    {
        if (url.Length >= 2048)
        {
            statusMessage = "Max length is 2048 characters\n";
            return false;
        }
    
        if (!ContainsValidCharacters(url))
        {
            statusMessage = "Url is not valid\n";
            return false;
        }

        return true;
    }
    
    private bool ContainsValidCharacters(string url)
    {
        Uri uriResult;
        return Uri.TryCreate(url, UriKind.Absolute, out uriResult) 
                      && (uriResult.Scheme == Uri.UriSchemeHttp || uriResult.Scheme == Uri.UriSchemeHttps);
    }
    
    private async Task CopyShortToClipboard()
    {
        await JS.InvokeVoidAsync("copyShortToClipboard", shortUrl);
    }

    private async Task CopySecretToClipboard()
    {
        await JS.InvokeVoidAsync("copySecretToClipboard", secretUrl);
    }

    private string GenerateShortCode(int length)
    {
        const string chars = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789";
        return new string(Enumerable.Repeat(chars, length)
            .Select(s => s[random.Next(s.Length)]).ToArray());
    }
}